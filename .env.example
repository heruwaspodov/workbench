# INTERNAL — copy to .env and fill. Never commit real secrets.
APP_URL=http://localhost:5173
PORT=3000
# Dev only: enables /auth/dev-login with this email while Mekari OAuth isn't set up yet
DEV_LOGIN_EMAIL=
DATABASE_URL=postgres://onedesk:onedesk@localhost:5432/onedesk

# Mekari OAuth2 (authorization code flow). ASSUMPTION: confirm endpoints & scopes with the Mekari SSO team.
MEKARI_OAUTH_AUTHORIZE_URL=
MEKARI_OAUTH_TOKEN_URL=
MEKARI_OAUTH_USERINFO_URL=
MEKARI_OAUTH_CLIENT_ID=
MEKARI_OAUTH_CLIENT_SECRET=
MEKARI_OAUTH_SCOPE=openid profile email
# Comma-separated emails that become admin on first login
ADMIN_EMAILS=
# Only allow these email domains to sign in
ALLOWED_EMAIL_DOMAINS=mekari.com

# Jira Cloud — service account (email + API token)
JIRA_BASE_URL=https://jurnal.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_ID=
JIRA_STORY_POINT_FIELD=customfield_10016

# Bitbucket Cloud — either a workspace/repository access token (Bearer) or email + API token (Basic)
BITBUCKET_WORKSPACE=
BITBUCKET_ACCESS_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# Google Sheets import — service account JSON (single line) with read access to the sheet
GOOGLE_SERVICE_ACCOUNT_JSON=
