# INTERNAL — copy to .env and fill. Never commit real secrets.
# Origin UI. Untuk OAuth Mekari SSO pakai host non-localhost, mis. APP_URL=http://one-desk.local (lihat README)
APP_URL=http://localhost:5173
PORT=3000
DATABASE_URL=postgres://localhost:5432/one-desk

# Mekari OAuth2 (authorization code flow, https://developers.mekari.com/docs/kb/authentication/oauth2).
# Authorize/token URLs: developers.mekari.com docs. USERINFO: Mekari SSO API GET /v1/users/me (Bearer token).
MEKARI_OAUTH_AUTHORIZE_URL=https://account.mekari.com/auth
MEKARI_OAUTH_TOKEN_URL=https://account.mekari.com/auth/oauth2/token
MEKARI_OAUTH_USERINFO_URL=https://api.mekari.com/v1/users/me
MEKARI_OAUTH_CLIENT_ID=
MEKARI_OAUTH_CLIENT_SECRET=
MEKARI_OAUTH_SCOPE=openid profile email
# Optional. Default {APP_URL}/sso-callback; must match the redirect URI registered in Mekari SSO exactly
# MEKARI_OAUTH_REDIRECT_URI=
# Comma-separated emails that become admin on first login
ADMIN_EMAILS=
# Only allow these email domains to sign in
ALLOWED_EMAIL_DOMAINS=mekari.com

# Jira Cloud — service account (email + API token). ATLASSIAN_EMAIL / ATLASSIAN_API_TOKEN are accepted as fallbacks for
# JIRA_EMAIL / JIRA_API_TOKEN and BITBUCKET_EMAIL / BITBUCKET_API_TOKEN (one Atlassian token for both)
JIRA_BASE_URL=https://jurnal.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Default Kanban board for users who haven't picked one in Connections (e.g. 2508 = Escape Kanban Board, project MESIGN)
JIRA_BOARD_ID=
# jurnal.atlassian.net: "Story Points" = customfield_10005 (verified); the Jira default customfield_10016 is empty here
JIRA_STORY_POINT_FIELD=customfield_10005
# Optional, site-specific: epic "Actual Delivery Date" and ticket "Toggle Name" custom fields (empty disables)
JIRA_DELIVERY_DATE_FIELD=customfield_11781
JIRA_TOGGLE_FIELD=customfield_11708
# Optional: epic Period and Project Status fields, and the project of the Fast Track SLA card (empty disables / any project)
JIRA_PERIOD_FIELD=customfield_11804
JIRA_PROJECT_STATUS_FIELD=customfield_12356
JIRA_SLA_PROJECT=MESIGN

# Bitbucket Cloud — either a workspace/repository access token (Bearer) or email + API token (Basic)
BITBUCKET_WORKSPACE=
BITBUCKET_ACCESS_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# Google Sheets import — service account JSON (single line) with read access to the sheet
GOOGLE_SERVICE_ACCOUNT_JSON=
MEKARI_OAUTH_PKCE=false
