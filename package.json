{
  "name": "one-desk",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd apps/server --env-file=../../.env dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/server --env-file=../../.env start",
    "typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
    "test": "cd apps/server && bun --env-file=../../.env test",
    "db:generate": "bun run --cwd apps/server --env-file=../../.env db:generate",
    "db:migrate": "bun run --cwd apps/server --env-file=../../.env db:migrate"
  }
}
