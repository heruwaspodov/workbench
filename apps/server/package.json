{
  "name": "@one-desk/server",
  "private": true,
  "type": "module",
  "module": "src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.31",
    "exceljs": "4.4.0",
    "google-auth-library": "11.3.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
